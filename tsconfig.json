{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "paths": {
      "@playable/host-runtime": [
        "./src/adapters/application-class/runtime.ts"
      ],
      "@playable/host-application": [
        "./src/adapters/application-class/application.ts"
      ]
    }
  },
  "include": [
    "runtime/**/*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "i18n/**/*.ts"
  ]
}
