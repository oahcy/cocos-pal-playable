{
  "name": "@cocos/pal-playable",
  "version": "0.1.0",
  "private": true,
  "description": "Private-source playable advertisement build platform for Cocos CLI",
  "license": "UNLICENSED",
  "type": "commonjs",
  "files": [
    "dist",
    "static",
    "i18n/*.js",
    "runtime/playable.d.ts",
    "README.md",
    "docs/wechat-alignment.md"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/build.ts && tsx --test tests/*.test.ts",
    "install:cli": "tsx scripts/install-cli.ts",
    "preview": "tsx scripts/preview.ts",
    "single-html": "tsx scripts/single-html.ts"
  },
  "contributes": {
    "builder": {
      "register": true,
      "platform": "playable",
      "config": "./dist/config.cjs",
      "hooks": "./dist/hooks.cjs"
    }
  },
  "dependencies": {
    "ejs": "3.1.10",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/node": "22.20.4",
    "esbuild": "0.25.5",
    "sharp": "0.32.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "sharp": "^0.32.6"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
