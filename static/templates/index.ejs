<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= title %></title>
  <%- headHTML %>
<% if (sdkPlacement === 'head') { %>
  <script src="<%= sdkURL %>"></script>
<% } %>
  <link rel="stylesheet" href="./style.css">
</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="true">
    <div id="Cocos3dGameContainer">
      <canvas id="GameCanvas" tabindex="0"></canvas>
    </div>
  </div>
<% if (sdkPlacement !== 'head') { %>
  <script src="<%= sdkURL %>"></script>
<% } %>
  <script data-playable-runtime src="./playable-runtime.js"></script>
<% if (polyfillsURL) { %>
  <script src="<%= polyfillsURL %>"></script>
<% } %>
  <script src="<%= systemURL %>"></script>
  <script type="systemjs-importmap" src="<%= importMapURL %>"></script>
  <script>System.import('./index.js').catch(console.error);</script>
</body>
</html>
